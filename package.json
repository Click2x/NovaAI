{
    "name":  "novaai",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Nova.Ai: a private, local AI companion for your desktop",
    "main":  "electron/main.js",
    "scripts":  {
                    "dev":  "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5174 \u0026\u0026 cross-env NOVA_DEV=1 electron .\"",
                    "build":  "vite build",
                    "start":  "vite build \u0026\u0026 electron .",
                    "test":  "node --test test/state.test.mjs test/screen.test.mjs test/settings.test.mjs test/packaging.test.mjs test/home.test.mjs test/updates.test.mjs test/today.test.mjs test/continuity.test.mjs test/gpu.test.mjs test/notify.test.mjs test/training.test.mjs test/code.test.mjs test/display.test.mjs test/onboarding.test.mjs test/orb.test.mjs test/layout.test.mjs test/sidecar.test.mjs",
                    "build:backend":  "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-backend.ps1",
                    "pack":  "vite build \u0026\u0026 electron-builder --dir",
                    "dist":  "npm run build:backend \u0026\u0026 vite build \u0026\u0026 electron-builder --win nsis",
                    "icon":  "node tools/make-icon.js"
                },
    "dependencies":  {
                         "@pixiv/three-vrm":  "^3.4.2",
                         "@ricky0123/vad-web":  "^0.0.31",
                         "get-windows":  "^9.3.0",
                         "three":  "^0.177.0"
                     },
    "devDependencies":  {
                            "concurrently":  "^9.1.0",
                            "cross-env":  "^7.0.3",
                            "electron":  "^37.2.0",
                            "electron-builder":  "^26.15.3",
                            "vite":  "^6.0.0",
                            "wait-on":  "^8.0.0"
                        },
    "build":  {
                  "appId":  "ai.novaai.desktop",
                  "productName":  "Nova.Ai",
                  "executableName":  "NovaAI",
                  "directories":  {
                                      "output":  "release",
                                      "buildResources":  "build"
                                  },
                  "files":  [
                                "electron/**/*",
                                "dist/**/*",
                                "package.json",
                                "build/icon.png",
                                "!node_modules/{three,@pixiv,@ricky0123,onnxruntime-web,onnxruntime-common,flatbuffers,guid-typescript,long,platform,protobufjs}/**"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "backend/dist/novaai-server",
                                             "to":  "backend/novaai-server"
                                         }
                                     ],
                  "asarUnpack":  [
                                     "node_modules/get-windows/**"
                                 ],
                  "win":  {
                              "icon":  "build/icon.ico",
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "deleteAppDataOnUninstall":  false,
                               "shortcutName":  "Nova.Ai"
                           },
                  "publish":  null,
                  "npmRebuild":  false
              },
    "author":  "Nova.Ai contributors",
    "repository":  {
                        "type":  "git",
                        "url":  "git+https://github.com/Click2x/NovaAI.git"
                    },
    "homepage":  "https://github.com/Click2x/NovaAI",
    "license":  "GPL-3.0-only"
}
