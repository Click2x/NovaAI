{
    "name":  "nova-desktop",
    "version":  "0.0.1",
    "private":  true,
    "description":  "Nova desktop avatar app",
    "main":  "electron/main.js",
    "scripts":  {
                    "dev":  "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5174 \u0026\u0026 cross-env NOVA_DEV=1 electron .\"",
                    "build":  "vite build",
                    "start":  "vite build \u0026\u0026 electron .",
                    "test":  "node --test test/state.test.mjs test/screen.test.mjs test/settings.test.mjs test/packaging.test.mjs",
                    "pack":  "vite build \u0026\u0026 electron-builder --dir",
                    "dist":  "vite build \u0026\u0026 electron-builder --win nsis"
                },
    "dependencies":  {
                         "@pixiv/three-vrm":  "^3.4.2",
                         "@ricky0123/vad-web":  "^0.0.31",
                         "get-windows":  "^9.3.0",
                         "three":  "^0.177.0"
                     },
    "devDependencies":  {
                            "concurrently":  "^9.1.0",
                            "cross-env":  "^7.0.3",
                            "electron":  "^37.2.0",
                            "electron-builder":  "^26.15.3",
                            "vite":  "^6.0.0",
                            "wait-on":  "^8.0.0"
                        },
    "build":  {
                  "appId":  "com.bryant.nova.desktop",
                  "productName":  "Nova",
                  "executableName":  "Nova",
                  "directories":  {
                                      "output":  "release",
                                      "buildResources":  "build"
                                  },
                  "files":  [
                                "electron/**/*",
                                "dist/**/*",
                                "package.json",
                                "!node_modules/{three,@pixiv,@ricky0123,onnxruntime-web,onnxruntime-common,flatbuffers,guid-typescript,long,platform,protobufjs}/**"
                            ],
                  "asarUnpack":  [
                                     "node_modules/get-windows/**"
                                 ],
                  "extraResources":  [
                                         {
                                             "from":  "../vrm_models/Nova_v1_grunge.vrm",
                                             "to":  "vrm/Nova_v1_grunge.vrm"
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "deleteAppDataOnUninstall":  false,
                               "shortcutName":  "Nova"
                           },
                  "publish":  null,
                  "npmRebuild":  false
              },
    "author":  "Bryant"
}
