{
  "name": "nova-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Nova desktop avatar app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5174 && cross-env NOVA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
